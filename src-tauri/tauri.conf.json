{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Wirl",
  "version": "0.1.0",
  "identifier": "app.wirl.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Wirl",
    "shortDescription": "Dictate into any text box",
    "longDescription": "Wirl lives in the system tray, transcribes your speech on your computer with Whisper, tidies it with Claude, and pastes it where your cursor is.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "externalBin": ["binaries/wirl-whisper", "binaries/wirl-whisper-cpu"],
    "createUpdaterArtifacts": false,
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": ["https://github.com/tobijeh/Wirl-Desktop/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
